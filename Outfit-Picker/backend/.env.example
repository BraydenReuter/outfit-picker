# Postgres connection string. Locally, e.g. a Docker or installed Postgres;
# in production, the connection string from Neon (or any Postgres host).
DATABASE_URL="postgresql://outfit:outfit@localhost:5432/outfit_dev"
# Separate database for `npm test`; the tests delete its rows.
TEST_DATABASE_URL="postgresql://outfit:outfit@localhost:5432/outfit_test"

HOST=127.0.0.1
PORT=4000
# Browser origin allowed by CORS (the Vite dev server).
CLIENT_URL=http://localhost:5173

# --- Optional; production values are set in render.yaml ---
# Serve the built frontend from Express (e.g. ../frontend/dist).
# STATIC_DIRECTORY=../frontend/dist
# Restore the sample wardrobe every N hours (0 = never).
# DEMO_RESET_HOURS=0
# MAX_CLOTHING_ITEMS=500
# MAX_OUTFITS=500
# MAX_STORED_IMAGES=1000
# Write requests per visitor IP per 15 minutes (0 = unlimited).
# WRITE_RATE_LIMIT=0
# Number of proxies in front of the app; 1 on Render.
# TRUST_PROXY=0
