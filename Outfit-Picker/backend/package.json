{
  "name": "backend",
  "version": "1.0.0",
  "description": "Outfit Picker backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/src/server.js",
    "test": "node scripts/prepareTestDatabase.cjs && jest --runInBand",
    "db:setup": "prisma migrate deploy && prisma generate",
    "db:migrate": "prisma migrate dev",
    "seed:demo": "tsx prisma/seed.ts",
    "cleanup:uploads": "tsx scripts/cleanupUploads.ts"
  },
  "keywords": [
    "outfit",
    "wardrobe",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "multer": "^2.3.0",
    "prisma": "^6.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
